# Docker Compose inputs. Copy to .env; see docker/README.md#environment-reference.
# Shell exports override .env. Keep real tokens in local .env, never in this file.

# omp: host config file (must exist), optional broker overrides, persistent client update.
OMP_CONFIG_FILE=./path-to/omp-config.yml
OMP_AUTH_BROKER_URL=
OMP_AUTH_BROKER_TOKEN=
# Prefer a one-off `docker compose run --rm -e OMP_UPDATE=1 maintenance omp --version`.
# Leaving 1 here reinstalls the client on every container start.
OMP_UPDATE=0

# One sequence of all five tasks, each in a fresh agent process.
# Timeout is per task (seconds), not for the whole sequence or Gradle preparation.
BANK_ICON_PASS_TIMEOUT_SECONDS=10800
# Compose restart policy: no, on-failure[:N], always, unless-stopped.
BANK_ICON_RESTART_POLICY=no
# interactive is only for a separately invoked human-driven session, not `run`.
BANK_ICON_INTERACTION=noninteractive

# Optional publication policy: absolute HOST path outside this checkout.
# Provision it yourself with configure-bank-publication.py; no SHA pin is used.
# Enable its read-only mount with -f compose.yaml -f compose.publication.yaml.
# Empty means no policy and grants no publication permission.
BANK_ICON_PUBLICATION_POLICY=

# Per-bank research counts, integers 0..1000 (0 disables that operation).
# Unset/comment out to use skill defaults (20/100/20); an empty value is invalid.
BANK_ICON_RESEARCH_SEARCH_LIMIT=20
BANK_ICON_RESEARCH_FETCH_LIMIT=100
BANK_ICON_RESEARCH_BROWSER_LIMIT=20

# GitHub API and HTTPS Git (including state); no SSH agent is needed.
# Fine-grained token: repository Contents and Pull requests, both read/write.
# Independent of omp auth and publication permission.
GH_TOKEN=

# Image build: set BANK_UID/BANK_GID to the numeric output of id -u / id -g.
BANK_UID=1000
BANK_GID=1000
# Set yes only after accepting the Android SDK licenses; needed even without emulator.
ACCEPT_ANDROID_SDK_LICENSES=no
INSTALL_ANDROID_EMULATOR=no
# Emulator override only: set to `stat -c %g /dev/kvm` on the host, not a fixed GID.
# KVM_GID=0

# Repository, SDK, Java, Python and cache paths are fixed by Compose/Dockerfile,
# not .env options. See docker/README.md for native iOS and image-build-only settings.
